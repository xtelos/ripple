     "expected": ["notes.helpers.note_filename", "notes.commands.cmd_find", "notes.store.NoteStore.add", "notes.commands.cmd_add", "notes.cli.run", "notes.cli.run_named", "notes.cli.main", "notes.__main__", "tests.test_cli.test_slugify", "tests.test_cli.test_add_then_list", "tests.test_cli.test_find_by_name", "tests.test_cli.test_module_entry_point"]},
    {"id": "N12", "fixture": "notes", "kind": "callees", "symbol": "notes.cli.run", "group": "callees",

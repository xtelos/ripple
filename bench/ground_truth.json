{
  "definition": "Y is a direct caller of X if running Y's own body can call X with no other repo-defined named function in between. Lambdas, comprehensions and generator expressions belong to the function they appear in. Module-level code belongs to the module. Decorator wrappers are real functions. Truth is what the program does at runtime, not what a static tool can see. Only repo-defined symbols count. impact expects the full set of transitive callers within the given depth, tests included. A constructor call targets Class.__init__ when the class defines one in source, else the class itself (for example a dataclass).",
  "queries": [
    {"id": "S1", "fixture": "shop", "kind": "callers", "symbol": "shop.models.Order.add_item", "group": "typed receivers",
     "note": "receiver is a local assigned from a constructor call",
     "expected": ["shop.service.OrderService.place_order", "tests.test_pricing.test_percent_discount_and_tax"]},
    {"id": "S2", "fixture": "shop", "kind": "callers", "symbol": "shop.pricing.price_order", "group": "imports",
     "note": "called through `import ... as quote` and a plain from-import",
     "expected": ["shop.service.OrderService.place_order", "shop.service.OrderService.reprice", "tests.test_pricing.test_percent_discount_and_tax"]},
    {"id": "S3", "fixture": "shop", "kind": "callers", "symbol": "shop.tax.tax_for", "group": "imports",
     "note": "`from . import tax` then tax.tax_for(...)",
     "expected": ["shop.pricing.price_order"]},
    {"id": "S4", "fixture": "shop", "kind": "callers", "symbol": "shop.discounts.Discount.__init__", "group": "methods",
     "note": "super().__init__ from two subclasses",
     "expected": ["shop.discounts.PercentOff.__init__", "shop.discounts.FixedOff.__init__"]},
    {"id": "S5", "fixture": "shop", "kind": "callers", "symbol": "shop.discounts.PercentOff.__init__", "group": "methods",
     "note": "constructor called through a module alias (disc.PercentOff) and a from-import",
     "expected": ["shop.service.OrderService.__init__", "tests.test_pricing.test_percent_discount_and_tax"]},
    {"id": "S6", "fixture": "shop", "kind": "callers", "symbol": "shop.repository.OrderRepository.save", "group": "typed receivers",
     "note": "self.repo is set in __init__ from an annotated parameter or a constructor",
     "expected": ["shop.service.OrderService.place_order"]},
    {"id": "S7", "fixture": "shop", "kind": "callers", "symbol": "shop.repository.OrderRepository._allocate_id", "group": "methods",
     "note": "self.method() inside the same class",
     "expected": ["shop.repository.OrderRepository.save"]},
    {"id": "S8", "fixture": "shop", "kind": "callers", "symbol": "shop.service.OrderService.__init__", "group": "imports",
     "note": "constructed through a package re-export (from shop import OrderService)",
     "expected": ["tests.test_service.test_place_order_applies_best_discount", "tests.test_service.test_reprice_drops_discounts"]},
    {"id": "S9", "fixture": "shop", "kind": "callers", "symbol": "shop.models.LineItem.subtotal", "group": "dynamic",
     "note": "receiver is a loop variable over a list with no element type",
     "expected": ["shop.models.Order.gross_total"]},
    {"id": "S10", "fixture": "shop", "kind": "callers", "symbol": "shop.discounts.PercentOff.amount_off", "group": "dynamic",
     "note": "override reached by self.amount_off() in the base class, and by a lambda over an untyped list",
     "expected": ["shop.discounts.Discount.apply", "shop.discounts.best_discount"]},
    {"id": "S11", "fixture": "shop", "kind": "callers", "symbol": "shop.discounts.Discount.apply", "group": "dynamic",
     "note": "receiver is the untyped return value of best_discount()",
     "expected": ["shop.pricing.price_order"]},
    {"id": "S12", "fixture": "shop", "kind": "callees", "symbol": "shop.service.OrderService.place_order", "group": "callees",
     "note": "dataclass constructor, typed local, self method, aliased import, self attribute",
     "expected": ["shop.models.Order", "shop.models.Order.add_item", "shop.service.OrderService._lookup_codes", "shop.pricing.price_order", "shop.repository.OrderRepository.save"]},
    {"id": "S13", "fixture": "shop", "kind": "impact", "symbol": "shop.tax.tax_for", "depth": 5, "group": "impact",
     "note": "every chain is statically visible",
     "expected": ["shop.pricing.price_order", "shop.service.OrderService.place_order", "shop.service.OrderService.reprice", "tests.test_pricing.test_percent_discount_and_tax", "tests.test_service.test_place_order_applies_best_discount", "tests.test_service.test_reprice_drops_discounts"]},
    {"id": "S14", "fixture": "shop", "kind": "impact", "symbol": "shop.models.LineItem.subtotal", "depth": 5, "group": "impact",
     "note": "the first hop is an untyped loop variable, so the whole chain hangs on it",
     "expected": ["shop.models.Order.gross_total", "shop.pricing.price_order", "shop.service.OrderService.place_order", "shop.service.OrderService.reprice", "tests.test_pricing.test_percent_discount_and_tax", "tests.test_service.test_place_order_applies_best_discount", "tests.test_service.test_reprice_drops_discounts"]},


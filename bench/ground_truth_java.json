    {"id": "strict-external-supertype-3", "group": "strict", "file": "src/main/java/com/acme/shop/Ledger.java", "line": 28, "text": "this.write(item.name())", "caller": "com.acme.shop.Ledger.record(Item)", "call": "write", "edges": [], "unresolved": "may declare another write", "why": "the same through this"},
    {"id": "strict-through-a-typed-receiver", "group": "strict", "file": "src/main/java/com/acme/shop/Ledger.java", "line": 32, "text": "ledger.record(item)", "caller": "com.acme.shop.Ledger.note(Ledger,Item)", "call": "record", "edges": ["call com.acme.shop.Ledger.record(Item)"], "why": "Writer is in the JDK table and no JDK gives it a method named record, so the call is Ledger.record(Item); `write` on the same receiver stays unresolved"},
    {"id": "strict-through-new", "group": "strict", "file": "src/test/java/com/acme/shop/CartTest.java", "line": 17, "text": "l.record(Item.free(\"z\"))", "caller": "com.acme.shop.CartTest.main(String[])", "call": "record", "edges": ["call com.acme.shop.Ledger.record(Item)"], "why": "the same from another class"},
    {"id": "strict-anonymous-class-of-jdk-interface", "group": "strict", "file": "src/main/java/com/acme/shop/Reports.java", "line": 29, "text": "helper()", "caller": "com.acme.shop.Reports.run()$1.run()", "call": "helper", "edges": ["call com.acme.shop.Reports.helper()"], "why": "java.lang.Runnable declares run and nothing else (the table of members ripple ships), so an anonymous Runnable inherits no helper and the comb rule moves out to Reports.helper"},
    {"id": "strict-external-receiver-with-repo-subtype", "group": "strict", "file": "src/main/java/com/acme/shop/Reports.java", "line": 32, "text": "r.run()", "caller": "com.acme.shop.Reports.run()", "call": "run", "edges": [], "unresolved": "a repo class that may be one declares run", "why": "r is a Runnable, and an anonymous class of the repo implements run: the call may reach repo code"},

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@wh/*": ["src/*"]
    },
    "types": ["vitest/globals"]
  },
  "include": ["src", "tests"]
}
